input {
  keyboard {
    xkb {
      layout "us"
      variant "dvorak"
      options "caps:swapescape"
    }
  }

  touchpad {
    tap
  }

  mouse {
    accel-speed 0.7
    accel-profile "flat"
  }

  focus-follows-mouse
  warp-mouse-to-focus mode="center-xy"
}

cursor {
  xcursor-theme "zhao"
  xcursor-size 32
}

gestures {
  hot-corners {
    off
  }
}
