output "eDP-1" {
  mode "1920x1080@60"
  position x=0 y=0
  scale 1.0
}

output "HDMI-A-1" {
  mode "1024x768@30"
  position x=0 y=0
  scale 1.0
}

environment {
  XCURSOR_SIZE "32"
  XCURSOR_THEME "zhao"
  QT_IM_MODULE "fcitx"
}

hotkey-overlay {
  skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/%Y/%b/%d/%Y-%m-%d_%H-%M.png"
